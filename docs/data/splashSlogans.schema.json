{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://staticcanvas.gitlab.io/typeflow/schemas/splash-slogans.schema.json",
  "title": "TypeFlow documentation splash slogans",
  "description": "Animation records consumed by the documentation splash sequence.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slogan", "mode"],
    "properties": {
      "slogan": { "type": "string", "minLength": 1 },
      "mode": { "type": "string", "minLength": 1 },
      "typeStyle": { "enum": ["char", "word", "scramble", "fade-trail"] },
      "eraseStyle": { "enum": ["end", "start", "center", "scramble", "fade-trail", "instant", "fade"] },
      "direction": { "enum": ["left", "right", "center"] },
      "scrambleCharset": { "type": "string", "minLength": 1 },
      "scrambleRounds": { "type": "integer", "minimum": 1, "maximum": 100 },
      "trailFade": { "type": "integer", "minimum": 1, "maximum": 100 },
      "speed": { "type": "number", "minimum": 0, "maximum": 10000 },
      "cursor": { "type": "string" },
      "html": { "type": "boolean" }
    }
  }
}
